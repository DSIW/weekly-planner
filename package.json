{
  "name": "weekly-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "knip": "knip",
    "test:ci": "run-s typecheck lint test knip",
    "dev": "run-p dev:server dev:web",
    "dev:server": "npm run dev -w @weekly-planner/server",
    "dev:web": "npm run dev -w @weekly-planner/web",
    "recipes:check": "npm run recipes:check -w @weekly-planner/server",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "husky": "9.1.7",
    "knip": "5.88.1",
    "npm-run-all2": "9.0.4",
    "typescript": "~5.6.3"
  }
}
