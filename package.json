{
  "name": "weekly-planner",
  "private": true,
  "version": "0.1.40",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "knip": "KNIP_DISABLE_RAW_TRANSFER=1 knip",
    "test:ci": "run-s typecheck lint test knip",
    "dev": "run-p dev:server dev:web",
    "dev:phone": "DEV_PHONE=1 DEV_ENV=.env.staging npm run dev",
    "dev:server": "npm run dev -w @weekly-planner/server",
    "dev:web": "npm run dev -w @weekly-planner/web",
    "recipes:check": "npm run recipes:check -w @weekly-planner/server",
    "prepare": "husky",
    "smoke": "node scripts/smoke.mjs",
    "staging:check": "node scripts/staging-check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "knip": "6.44.2",
    "npm-run-all2": "9.0.4",
    "typescript": "7.0.2"
  }
}
