# KitchenOwl (required)
KITCHENOWL_URL=https://kitchenowl.example.org
KITCHENOWL_TOKEN=long-lived-token-from-kitchenowl
KITCHENOWL_HOUSEHOLD_ID=2
# Optional: where phones reach KitchenOwl (a URL, or / on a shared host); enables links from the planner
# KITCHENOWL_PUBLIC_URL=https://kitchenowl.example.org

# The KitchenOwl shopping list that "Einkaufsliste füllen" writes to (id, not name; default 2).
# The lists of household 2 are REWE (2) and Drogerie (3).
# SHOPPING_LIST_ID=2
# Who the push services can contact about this server: a mailto: address or an https URL.
# VAPID_SUBJECT=mailto:you@example.org

# Server (required for `npm run dev` and the container)
# At least 32 characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=generate-a-long-random-string-with-at-least-32-characters

# Server (optional, defaults shown)
# PORT=3000
# SQLite file; the container uses /app/data/planner.sqlite (mount ./data there)
# DATABASE_PATH=data/planner.sqlite
# Time zone of the household, for "today" and reminders
# HOUSEHOLD_TIMEZONE=Europe/Berlin
# BASE_PATH=/plan
# Set to false for plain http on localhost
# COOKIE_SECURE=true
# TRUST_PROXY=true
