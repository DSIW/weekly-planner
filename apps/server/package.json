{
  "name": "@weekly-planner/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "recipes:check": "tsx --env-file-if-exists=../../.env src/main/recipes-check.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.1",
    "@weekly-planner/application": "*",
    "@weekly-planner/domain": "*",
    "fastify": "5.12.7",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/web-push": "3.6.4",
    "esbuild": "0.28.2",
    "tsx": "^4.19.2",
    "vitest": "^5.0.5"
  }
}
